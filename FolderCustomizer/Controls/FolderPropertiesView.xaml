<UserControl x:Class="FolderCustomizer.Views.Controls.FolderPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editor="clr-namespace:FolderCustomizer.Editor">

        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0">

                <Grid>
                        <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->

                        <Border Grid.Row="0"
                                Background="#F5F5F5"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1">

                                <TextBlock Text="Properties"
                                           Margin="14,0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           FontSize="12"/>
                        </Border>

                        <!-- Properties -->

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">

                                <StackPanel Margin="16">

                                        <!-- Target folder -->

                                        <TextBlock Text="Target folder"
                                                   Style="{StaticResource SectionTitleStyle}"/>

                                        <TextBlock Text="Folder path"
                                                   Style="{StaticResource PropertyLabelStyle}"
                                                   Margin="0,12,0,5"/>

                                        <Grid Margin="0,0,0,20">
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Height="32"
                                                        Padding="8,0"
                                                        Background="#FAFAFA"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="2">

                                                        <TextBlock Text="{Binding SelectedFolderPath,
                                                     TargetNullValue=No folder selected,
                                                     FallbackValue=No folder selected}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                                                </Border>

                                                <Button Grid.Column="2"
                                                        Content="Browse..."
                                                        Style="{StaticResource StandardButtonStyle}"
                                                        Command="{Binding SelectFolderCommand}"/>
                                        </Grid>

                                        <Border Height="1"
                                                Margin="0,0,0,18"
                                                Background="{StaticResource SoftBorderBrush}"/>

                                        <!-- Appearance -->

                                        <TextBlock Text="Appearance"
                                                   Style="{StaticResource SectionTitleStyle}"/>

                                        <Grid Margin="0,14,0,6">
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="Folder colour"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource PropertyLabelStyle}"
                                                           Margin="0"/>

                                                <Button Grid.Column="1"
                                                        Content="Reset"
                                                        IsEnabled="{Binding IsEditorEnabled}"
                                                        Height="24"
                                                        Padding="8,0"
                                                        BorderThickness="0"
                                                        Background="Transparent"
                                                        Foreground="{StaticResource AccentBrush}"
                                                        FontSize="11"
                                                        Cursor="Hand"
                                                        Command="{Binding ResetColourCommand}"/>
                                        </Grid>

                                        <Button Height="42"
                                                IsEnabled="{Binding IsEditorEnabled}"
                                                Style="{StaticResource PropertyButtonStyle}"
                                                Command="{Binding ChooseColourCommand}">

                                                <Grid>
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="10"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Width="22"
                                                                Height="22"
                                                                VerticalAlignment="Center"
                                                                Background="{Binding ColourPreviewBrush}"
                                                                BorderBrush="{Binding ColourPreviewBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="2"/>

                                                        <StackPanel Grid.Column="2"
                                                                    VerticalAlignment="Center">

                                                                <TextBlock Text="Colour"
                                                                           FontSize="12"/>

                                                                <TextBlock Text="{Binding SelectedColourText}"
                                                                           Margin="0,1,0,0"
                                                                           FontSize="10"
                                                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="3"
                                                                   Text="▼"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="9"
                                                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                                                </Grid>
                                        </Button>

                                        <Border Height="1"
                                                Margin="0,20,0,18"
                                                Background="{StaticResource SoftBorderBrush}"/>

                                        <!-- Image editing -->

                                        <TextBlock Text="Image editing"
                                                   Style="{StaticResource SectionTitleStyle}"/>

                                        <StackPanel Margin="0,12,0,0">

                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,0,0,7">

                                                        <TextBlock Width="70"
                                                                   Text="Move"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"/>

                                                        <TextBlock Text="Drag image"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,0,0,7">

                                                        <TextBlock Width="70"
                                                                   Text="Resize"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"/>

                                                        <TextBlock Text="Drag corner handle"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,0,0,7">

                                                        <TextBlock Width="70"
                                                                   Text="Ratio"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"/>

                                                        <TextBlock Text="Hold Shift"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,0,0,7">

                                                        <TextBlock Width="70"
                                                                   Text="Centre"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"/>

                                                        <TextBlock Text="Hold Ctrl"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,0,0,16">

                                                        <TextBlock Width="70"
                                                                   Text="Delete"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"/>

                                                        <TextBlock Text="Press Delete"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                                                </StackPanel>

                                                <!-- Crop -->

                                                <TextBlock Text="Crop shape"
                                                           Style="{StaticResource PropertyLabelStyle}"
                                                           Margin="0,0,0,6"/>

                                                <WrapPanel IsEnabled="{Binding HasSelectedOverlay}">
                                                        <Button Content="None"
                                                                Margin="0,0,6,6"
                                                                Style="{StaticResource StandardButtonStyle}"
                                                                Command="{Binding SetCropShapeCommand}"
                                                                CommandParameter="{x:Static editor:ImageCropShape.None}"/>

                                                        <Button Content="Rounded"
                                                                Margin="0,0,6,6"
                                                                Style="{StaticResource StandardButtonStyle}"
                                                                Command="{Binding SetCropShapeCommand}"
                                                                CommandParameter="{x:Static editor:ImageCropShape.RoundedRectangle}"/>

                                                        <Button Content="Circle"
                                                                Margin="0,0,6,6"
                                                                Style="{StaticResource StandardButtonStyle}"
                                                                Command="{Binding SetCropShapeCommand}"
                                                                CommandParameter="{x:Static editor:ImageCropShape.Circle}"/>

                                                        <Button Content="Folder + tab"
                                                                Margin="0,0,6,6"
                                                                Style="{StaticResource StandardButtonStyle}"
                                                                Command="{Binding SetCropShapeCommand}"
                                                                CommandParameter="{x:Static editor:ImageCropShape.Folder}"/>

                                                        <Button Content="Folder"
                                                                Margin="0,0,6,6"
                                                                Style="{StaticResource StandardButtonStyle}"
                                                                Command="{Binding SetCropShapeCommand}"
                                                                CommandParameter="{x:Static editor:ImageCropShape.FolderWithoutTab}"/>
                                                </WrapPanel>

                                        </StackPanel>

                                </StackPanel>
                        </ScrollViewer>
                </Grid>
        </Border>

</UserControl>