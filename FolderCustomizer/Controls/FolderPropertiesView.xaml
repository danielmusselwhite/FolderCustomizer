<UserControl x:Class="FolderCustomizer.Views.Controls.FolderPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1,0,0,0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#F5F5F5"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">

                <TextBlock Text="Properties"
                           Margin="14,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="12"/>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="16">

                    <TextBlock Text="Target folder"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <TextBlock Text="Folder path"
                               Style="{StaticResource PropertyLabelStyle}"
                               Margin="0,12,0,5"/>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Height="32"
                                Padding="8,0"
                                Background="#FAFAFA"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2">

                            <TextBlock Text="{Binding SelectedFolderPath,
                                                     TargetNullValue=No folder selected,
                                                     FallbackValue=No folder selected}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                        </Border>

                        <Button Grid.Column="2"
                                Content="Browse..."
                                Style="{StaticResource StandardButtonStyle}"
                                Command="{Binding SelectFolderCommand}"/>
                    </Grid>

                    <Border Height="1"
                            Margin="0,0,0,18"
                            Background="{StaticResource SoftBorderBrush}"/>

                    <TextBlock Text="Appearance"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <Grid Margin="0,14,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Folder colour"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource PropertyLabelStyle}"
                                   Margin="0"/>

                        <Button Grid.Column="1"
                                Content="Reset"
                                IsEnabled="{Binding IsEditorEnabled}"
                                Height="24"
                                Padding="8,0"
                                BorderThickness="0"
                                Background="Transparent"
                                Foreground="{StaticResource AccentBrush}"
                                FontSize="11"
                                Cursor="Hand"
                                Command="{Binding ResetColourCommand}"/>
                    </Grid>

                    <Button Height="42"
                            IsEnabled="{Binding IsEditorEnabled}"
                            Style="{StaticResource PropertyButtonStyle}"
                            Command="{Binding ChooseColourCommand}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="22"
                                    Height="22"
                                    VerticalAlignment="Center"
                                    Background="{Binding ColourPreviewBrush}"
                                    BorderBrush="{Binding ColourPreviewBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2"/>

                            <StackPanel Grid.Column="2"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Colour"
                                           FontSize="12"/>

                                <TextBlock Text="{Binding SelectedColourText}"
                                           Margin="0,1,0,0"
                                           FontSize="10"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="3"
                                       Text="▼"
                                       VerticalAlignment="Center"
                                       FontSize="9"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                        </Grid>
                    </Button>

                    <Border Height="1"
                            Margin="0,20,0,18"
                            Background="{StaticResource SoftBorderBrush}"/>

                    <TextBlock Text="Image editing"
                               Style="{StaticResource SectionTitleStyle}"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Move"
                                   Margin="0,0,0,7"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Text="Drag image"
                                   Margin="0,0,0,7"
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Resize"
                                   Margin="0,0,0,7"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="Drag corner handle"
                                   Margin="0,0,0,7"
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Ratio"
                                   Margin="0,0,0,7"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Text="Hold Shift"
                                   Margin="0,0,0,7"
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="Centre"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="3"
                                   Grid.Column="1"
                                   Text="Hold Ctrl"
                                   Margin="0,0,0,7"
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>

                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Text="Delete"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="4"
                                   Grid.Column="1"
                                   Text="Press Delete"
                                   Margin="0,0,0,7"
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>