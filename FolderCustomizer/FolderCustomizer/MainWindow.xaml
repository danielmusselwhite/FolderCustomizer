<Window x:Class="FolderCustomizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FolderCustomizer"
        mc:Ignorable="d"

        Title="Folder Customizer"
        Width="1100"
        Height="720"
        MinWidth="860"
        MinHeight="600"

        WindowStartupLocation="CenterScreen"

        Background="#F7F7F7"

        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14">

    <Window.Resources>

        <!-- ========================================================= -->
        <!-- Palette -->
        <!-- ========================================================= -->

        <SolidColorBrush x:Key="AppBackgroundBrush"
                         Color="#F7F7F7"/>

        <SolidColorBrush x:Key="PanelBrush"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="EditorBackgroundBrush"
                         Color="#F2F2F2"/>

        <SolidColorBrush x:Key="ControlBackgroundBrush"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="ControlHoverBrush"
                         Color="#F5F5F5"/>

        <SolidColorBrush x:Key="ControlPressedBrush"
                         Color="#EBEBEB"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#E2E2E2"/>

        <SolidColorBrush x:Key="StrongBorderBrush"
                         Color="#CCCCCC"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#202020"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#686868"/>

        <SolidColorBrush x:Key="TertiaryTextBrush"
                         Color="#8A8A8A"/>

        <SolidColorBrush x:Key="AccentBrush"
                         Color="#0067C0"/>

        <SolidColorBrush x:Key="AccentHoverBrush"
                         Color="#1975C5"/>

        <SolidColorBrush x:Key="AccentPressedBrush"
                         Color="#005A9E"/>


        <!-- ========================================================= -->
        <!-- Typography -->
        <!-- ========================================================= -->

        <Style x:Key="WindowTitleStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="FontSize"
                    Value="20"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>


        <Style x:Key="SectionHeaderStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>


        <Style x:Key="PropertyLabelStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Margin"
                    Value="0,0,0,7"/>

        </Style>


        <!-- ========================================================= -->
        <!-- Buttons -->
        <!-- ========================================================= -->

        <Style x:Key="ButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="Background"
                    Value="{StaticResource ControlBackgroundBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource StrongBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource ControlHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource ControlPressedBrush}"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter Property="Opacity"
                                        Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ButtonStyle}">

            <Setter Property="MinWidth"
                    Value="112"/>

            <Setter Property="Background"
                    Value="{StaticResource AccentBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource AccentBrush}"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource AccentHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource AccentPressedBrush}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================================= -->
        <!-- Property-style button -->
        <!-- ========================================================= -->

        <Style x:Key="PropertyButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ButtonStyle}">

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="Height"
                    Value="40"/>

        </Style>

    </Window.Resources>


    <!-- ============================================================= -->
    <!-- Application layout -->
    <!-- ============================================================= -->

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="54"/>
        </Grid.RowDefinitions>


        <!-- ========================================================= -->
        <!-- Header -->
        <!-- ========================================================= -->

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">

            <Grid Margin="24,0">

                <StackPanel
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="Folder Customizer"
                        Style="{StaticResource WindowTitleStyle}"/>

                    <TextBlock
                        Text="Create a custom icon for any Windows folder"
                        Margin="0,3,0,0"
                        FontSize="12"
                        Foreground="{StaticResource SecondaryTextBrush}"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- Workspace -->
        <!-- ========================================================= -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <!-- Editor fills available space -->

                <ColumnDefinition Width="*"
                                  MinWidth="480"/>

                <!-- Inspector -->

                <ColumnDefinition Width="330"/>

            </Grid.ColumnDefinitions>


            <!-- ===================================================== -->
            <!-- Editor workspace -->
            <!-- ===================================================== -->

            <Grid Grid.Column="0"
                  Background="{StaticResource EditorBackgroundBrush}">

                <!-- Editor surface -->

                <Border
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"

                    Padding="20"

                    Background="#FAFAFA"

                    BorderBrush="#DEDEDE"
                    BorderThickness="1"

                    CornerRadius="8">

                    <Border.Effect>

                        <DropShadowEffect
                            BlurRadius="18"
                            ShadowDepth="2"
                            Opacity="0.10"/>

                    </Border.Effect>


                    <Border
                        Width="264"
                        Height="264"

                        Background="White"

                        BorderBrush="#E8E8E8"
                        BorderThickness="1">

                        <Canvas
                            Name="iconEditorCanvas"

                            Width="264"
                            Height="264"

                            Background="Transparent"/>

                    </Border>

                </Border>


                <!-- Canvas hint -->

                <Border
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"

                    Margin="20"

                    Padding="10,6"

                    Background="#E8E8E8"
                    CornerRadius="4">

                    <TextBlock
                        Text="Click an image to select · Drag to move · Delete to remove"
                        FontSize="11"
                        Foreground="{StaticResource SecondaryTextBrush}"/>

                </Border>

            </Grid>


            <!-- ===================================================== -->
            <!-- Inspector -->
            <!-- ===================================================== -->

            <Border
                Grid.Column="1"

                Background="{StaticResource PanelBrush}"

                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="24">


                        <!-- ================================================= -->
                        <!-- Folder -->
                        <!-- ================================================= -->

                        <TextBlock
                            Text="Folder"
                            Style="{StaticResource SectionHeaderStyle}"/>

                        <TextBlock
                            Text="Target folder"
                            Style="{StaticResource PropertyLabelStyle}"
                            Margin="0,18,0,7"/>


                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <Border
                                Grid.Column="0"

                                Height="36"

                                Padding="10,0"

                                Background="#F8F8F8"

                                BorderBrush="{StaticResource StrongBorderBrush}"
                                BorderThickness="1"

                                CornerRadius="5">

                                <TextBlock
                                    Name="txt_SelectedFolder"

                                    Text="No folder selected"

                                    VerticalAlignment="Center"

                                    TextTrimming="CharacterEllipsis"

                                    ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"

                                    FontSize="12"

                                    Foreground="{StaticResource SecondaryTextBrush}"/>

                            </Border>


                            <Button
                                Grid.Column="2"

                                Name="btn_LoadFolder"

                                Content="Browse…"

                                Style="{StaticResource ButtonStyle}"

                                Click="Btn_Load_Click"/>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- Divider -->
                        <!-- ================================================= -->

                        <Border
                            Height="1"

                            Margin="0,24"

                            Background="{StaticResource BorderBrush}"/>


                        <!-- ================================================= -->
                        <!-- Appearance -->
                        <!-- ================================================= -->

                        <TextBlock
                            Text="Appearance"
                            Style="{StaticResource SectionHeaderStyle}"/>


                        <TextBlock
                            Text="Folder colour"
                            Style="{StaticResource PropertyLabelStyle}"
                            Margin="0,18,0,7"/>


                        <Button
                            Name="btn_ColourPicker"

                            Style="{StaticResource PropertyButtonStyle}"

                            Click="Btn_ColourPicker_Click">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>


                                <Border
                                    x:Name="folderColourPreview"

                                    Width="20"
                                    Height="20"

                                    VerticalAlignment="Center"

                                    Background="#F6C344"

                                    BorderBrush="#C7A138"
                                    BorderThickness="1"

                                    CornerRadius="3"/>


                                <TextBlock
                                    Grid.Column="2"

                                    Text="Choose colour"

                                    VerticalAlignment="Center"

                                    FontSize="13"/>


                                <TextBlock
                                    Grid.Column="3"

                                    Text="›"

                                    VerticalAlignment="Center"

                                    FontSize="18"

                                    Foreground="{StaticResource SecondaryTextBrush}"/>

                            </Grid>

                        </Button>


                        <!-- ================================================= -->
                        <!-- Divider -->
                        <!-- ================================================= -->

                        <Border
                            Height="1"

                            Margin="0,24"

                            Background="{StaticResource BorderBrush}"/>


                        <!-- ================================================= -->
                        <!-- Overlay -->
                        <!-- ================================================= -->

                        <TextBlock
                            Text="Overlay image"
                            Style="{StaticResource SectionHeaderStyle}"/>

                        <TextBlock
                            Text="Add a logo, symbol or other image on top of the folder."
                            Margin="0,7,0,14"

                            FontSize="12"

                            TextWrapping="Wrap"

                            Foreground="{StaticResource SecondaryTextBrush}"/>


                        <Button
                            Name="btn_addImage"

                            Style="{StaticResource PropertyButtonStyle}"

                            Click="Btn_AddImage_Click">

                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">

                                <TextBlock
                                    Text="+"
                                    Margin="0,-1,7,0"
                                    FontSize="17"/>

                                <TextBlock
                                    Text="Add image"
                                    VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>


                        <!-- ================================================= -->
                        <!-- Help -->
                        <!-- ================================================= -->

                        <Border
                            Margin="0,24,0,0"

                            Padding="12"

                            Background="#F7F7F7"

                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"

                            CornerRadius="5">

                            <StackPanel>

                                <TextBlock
                                    Text="Editor controls"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextBrush}"/>

                                <TextBlock
                                    Margin="0,7,0,0"

                                    FontSize="11"

                                    Foreground="{StaticResource SecondaryTextBrush}"

                                    TextWrapping="Wrap">

                                    <Run Text="Drag"/>
                                    <Run Text=" to move  ·  "/>

                                    <Run Text="Shift"/>
                                    <Run Text=" resize to keep ratio"/>

                                    <LineBreak/>

                                    <Run Text="Ctrl"/>
                                    <Run Text=" resize from centre  ·  "/>

                                    <Run Text="Delete"/>
                                    <Run Text=" removes"/>

                                </TextBlock>

                            </StackPanel>

                        </Border>


                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>


        <!-- ========================================================= -->
        <!-- Command / status bar -->
        <!-- ========================================================= -->

        <Border
            Grid.Row="2"

            Background="{StaticResource PanelBrush}"

            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="264 × 264"

                        VerticalAlignment="Center"

                        FontSize="11"

                        Foreground="{StaticResource TertiaryTextBrush}"/>

                </StackPanel>


                <Button
                    Grid.Column="1"

                    Name="btn_saveImg"

                    Content="Apply icon"

                    VerticalAlignment="Center"

                    Style="{StaticResource PrimaryButtonStyle}"

                    Click="Btn_UpdateFolder_Icon"/>

            </Grid>

        </Border>

    </Grid>

</Window>