<Window x:Class="FolderCustomizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FolderCustomizer"
        mc:Ignorable="d"
        Title="Folder Customizer"
        Width="980"
        Height="650"
        MinWidth="820"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>

        <!-- ========================================================= -->
        <!-- Office-like palette -->
        <!-- ========================================================= -->

        <SolidColorBrush x:Key="WindowBackgroundBrush"
                         Color="#F3F3F3"/>

        <SolidColorBrush x:Key="SurfaceBrush"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="ToolbarBrush"
                         Color="#FAFAFA"/>

        <SolidColorBrush x:Key="WorkspaceBrush"
                         Color="#E9E9E9"/>

        <SolidColorBrush x:Key="ControlBrush"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="ControlHoverBrush"
                         Color="#F0F0F0"/>

        <SolidColorBrush x:Key="ControlPressedBrush"
                         Color="#E2E2E2"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#CCCCCC"/>

        <SolidColorBrush x:Key="SoftBorderBrush"
                         Color="#DDDDDD"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#202020"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#666666"/>

        <SolidColorBrush x:Key="AccentBrush"
                         Color="#185ABD"/>

        <SolidColorBrush x:Key="AccentHoverBrush"
                         Color="#144E9F"/>

        <SolidColorBrush x:Key="AccentPressedBrush"
                         Color="#103F80"/>


        <!-- ========================================================= -->
        <!-- Typography -->
        <!-- ========================================================= -->

        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

        </Style>


        <Style x:Key="PropertyLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}"/>

            <Setter Property="Margin"
                    Value="0,0,0,5"/>

        </Style>


        <!-- ========================================================= -->
        <!-- Standard button -->
        <!-- ========================================================= -->

        <Style x:Key="StandardButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="32"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="Background"
                    Value="{StaticResource ControlBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource ControlHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource ControlPressedBrush}"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter Property="Opacity"
                                        Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================================= -->
        <!-- Primary button -->
        <!-- ========================================================= -->

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource StandardButtonStyle}">

            <Setter Property="MinWidth"
                    Value="100"/>

            <Setter Property="Background"
                    Value="{StaticResource AccentBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource AccentBrush}"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource AccentHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{StaticResource AccentPressedBrush}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================================= -->
        <!-- Toolbar button -->
        <!-- ========================================================= -->

        <Style x:Key="ToolbarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource StandardButtonStyle}">

            <Setter Property="Height"
                    Value="62"/>

            <Setter Property="MinWidth"
                    Value="76"/>

            <Setter Property="Padding"
                    Value="10,5"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Background"
                    Value="Transparent"/>

        </Style>


        <!-- ========================================================= -->
        <!-- Property button -->
        <!-- ========================================================= -->

        <Style x:Key="PropertyButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource StandardButtonStyle}">

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

        </Style>

    </Window.Resources>


    <!-- ============================================================= -->
    <!-- Root -->
    <!-- ============================================================= -->

    <Grid Background="{StaticResource WindowBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- Office-style command bar -->
        <!-- ========================================================= -->

        <Border
            Grid.Row="0"
            Background="{StaticResource ToolbarBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">

            <Grid Margin="8,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- Browse -->

                <Button
                    Grid.Column="0"
                    Name="btn_LoadFolder"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding SelectFolderCommand}">

                    <StackPanel
                        HorizontalAlignment="Center">

                        <TextBlock
                            Text="▣"
                            HorizontalAlignment="Center"
                            FontSize="20"
                            Foreground="{StaticResource AccentBrush}"/>

                        <TextBlock
                            Text="Browse folder"
                            Margin="0,4,0,0"
                            FontSize="11"/>

                    </StackPanel>

                </Button>


                <!-- Divider -->

                <Border
                    Grid.Column="1"
                    Width="1"
                    Margin="6,10"
                    Background="{StaticResource BorderBrush}"/>


                <!-- Add -->

                <Button
                    Grid.Column="2"
                    Name="btn_addImage"
                    IsEnabled="{Binding IsEditorEnabled}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding AddImageCommand}">

                    <StackPanel
                        HorizontalAlignment="Center">

                        <TextBlock
                            Text="+"
                            HorizontalAlignment="Center"
                            FontSize="23"
                            Foreground="{StaticResource AccentBrush}"/>

                        <TextBlock
                            Text="Add image"
                            Margin="0,3,0,0"
                            FontSize="11"/>

                    </StackPanel>

                </Button>


                <Border
                    Grid.Column="3"
                    Width="1"
                    Margin="6,10"
                    Background="{StaticResource BorderBrush}"/>


                <!-- Apply -->

                <Button
                    Grid.Column="4"
                    Style="{StaticResource ToolbarButtonStyle}"
                    x:Name="btn_ApplyToolbar"
                    IsEnabled="{Binding IsEditorEnabled}"
                    Command="{Binding ApplyIconCommand}">

                    <StackPanel
                        HorizontalAlignment="Center">

                        <TextBlock
                            Text="✓"
                            HorizontalAlignment="Center"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AccentBrush}"/>

                        <TextBlock
                            Text="Apply icon"
                            Margin="0,4,0,0"
                            FontSize="11"/>

                    </StackPanel>

                </Button>

                <Border
                    Grid.Column="5"
                    Width="1"
                    Margin="6,10"
                    Background="{StaticResource BorderBrush}"/>

                <Button
                    Grid.Column="6"
                    x:Name="btn_ClearStyle"
                    IsEnabled="{Binding HasExistingStyle}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding ClearStyleCommand}">

                    <StackPanel HorizontalAlignment="Center">

                        <TextBlock
                            Text="×"
                            HorizontalAlignment="Center"
                            FontSize="22"
                            Foreground="{StaticResource AccentBrush}"/>

                        <TextBlock
                            Text="Clear style"
                            Margin="0,3,0,0"
                            FontSize="11"
                            LineHeight="14"
                            LineStackingStrategy="BlockLineHeight"/>

                    </StackPanel>

                </Button>
            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- Main content -->
        <!-- ========================================================= -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"
                                  MinWidth="470"/>

                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>


            <!-- ===================================================== -->
            <!-- Editor -->
            <!-- ===================================================== -->

            <Grid
                Grid.Column="0"
                Background="{StaticResource WorkspaceBrush}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- Workspace caption -->

                <Border
                    Grid.Row="0"
                    Height="34"
                    Background="#F5F5F5"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">

                    <Grid Margin="12,0">

                        <TextBlock
                            Text="Preview"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextBrush}"/>

                    </Grid>

                </Border>


                <!-- Editor canvas -->

                <Grid
                    Grid.Row="1"
                    IsEnabled="{Binding IsEditorEnabled}">

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                        <Border
                            Padding="16"
                            Background="#F8F8F8"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">

                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="8"
                                    ShadowDepth="2"
                                    Opacity="0.10"/>
                            </Border.Effect>

                            <Border
                                Width="258"
                                Height="258"
                                Background="White"
                                BorderBrush="#BDBDBD"
                                BorderThickness="1">

                                <Canvas
                                    Name="iconEditorCanvas"
                                    Width="256"
                                    Height="256"
                                    Background="Transparent"/>

                            </Border>

                        </Border>

                        <TextBlock
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            Text="Select an overlay to move, resize or rotate it"
                            FontSize="11"
                            Foreground="{StaticResource SecondaryTextBrush}"/>

                    </StackPanel>

                </Grid>
            </Grid>


            <!-- ===================================================== -->
            <!-- Properties panel -->
            <!-- ===================================================== -->

            <Border
                Grid.Column="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- Property header -->

                    <Border
                        Grid.Row="0"
                        Background="#F5F5F5"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">

                        <TextBlock
                            Text="Properties"
                            Margin="14,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            FontSize="12"/>

                    </Border>


                    <ScrollViewer
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">

                        <StackPanel Margin="16">


                            <!-- ========================================= -->
                            <!-- Target folder -->
                            <!-- ========================================= -->

                            <TextBlock
                                Text="Target folder"
                                Style="{StaticResource SectionTitleStyle}"/>


                            <TextBlock
                                Text="Folder path"
                                Style="{StaticResource PropertyLabelStyle}"
                                Margin="0,12,0,5"/>


                            <Grid Margin="0,0,0,20">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>


                                <Border
                                    Grid.Column="0"
                                    Height="32"
                                    Padding="8,0"
                                    Background="#FAFAFA"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2">

                                    <TextBlock
                                        Text="{Binding SelectedFolderPath,
                                        TargetNullValue=No folder selected,
                                        FallbackValue=No folder selected}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        FontSize="11"
                                        Foreground="{StaticResource SecondaryTextBrush}"/>

                                </Border>


                                <Button
                                    Grid.Column="2"
                                    Content="Browse..."
                                    Style="{StaticResource StandardButtonStyle}"
                                    Command="{Binding SelectFolderCommand}"/>

                            </Grid>


                            <!-- Divider -->

                            <Border
                                Height="1"
                                Margin="0,0,0,18"
                                Background="{StaticResource SoftBorderBrush}"/>


                            <!-- ========================================= -->
                            <!-- Appearance -->
                            <!-- ========================================= -->

                            <TextBlock
                                Text="Appearance"
                                Style="{StaticResource SectionTitleStyle}"/>


                            <Grid Margin="0,14,0,6">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="Folder colour"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource PropertyLabelStyle}"
                                    Margin="0"/>

                                <Button
                                    Grid.Column="1"
                                    x:Name="btn_ResetColour"
                                    Content="Reset"
                                    IsEnabled="{Binding IsEditorEnabled}"
                                    Height="24"
                                    Padding="8,0"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Foreground="{StaticResource AccentBrush}"
                                    FontSize="11"
                                    Cursor="Hand"
                                    Command="{Binding ResetColourCommand}"/>

                            </Grid>


                            <Button
                                Name="btn_ColourPicker"
                                Height="42"
                                IsEnabled="{Binding IsEditorEnabled}"
                                Style="{StaticResource PropertyButtonStyle}"
                                Command="{Binding ChooseColourCommand}">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>


                                    <Border
                                        x:Name="folderColourPreview"
                                        Width="22"
                                        Height="22"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2"/>


                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="Colour"
                                            FontSize="12"/>

                                        <TextBlock
                                            Text="{Binding SelectedColourText}"
                                            Margin="0,1,0,0"
                                            FontSize="10"
                                            Foreground="{StaticResource SecondaryTextBrush}"/>

                                    </StackPanel>


                                    <TextBlock
                                        Grid.Column="3"
                                        Text="▼"
                                        VerticalAlignment="Center"
                                        FontSize="9"
                                        Foreground="{StaticResource SecondaryTextBrush}"/>

                                </Grid>

                            </Button>


                            <!-- Divider -->

                            <Border
                                Height="1"
                                Margin="0,20,0,18"
                                Background="{StaticResource SoftBorderBrush}"/>


                            <!-- ========================================= -->
                            <!-- Editor information -->
                            <!-- ========================================= -->

                            <TextBlock
                                Text="Image editing"
                                Style="{StaticResource SectionTitleStyle}"/>


                            <Grid Margin="0,12,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>


                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="Move"
                                    Margin="0,0,0,7"
                                    FontSize="11"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="Drag image"
                                    Margin="0,0,0,7"
                                    FontSize="11"
                                    Foreground="{StaticResource SecondaryTextBrush}"/>


                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="Resize"
                                    Margin="0,0,0,7"
                                    FontSize="11"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="Drag corner handle"
                                    Margin="0,0,0,7"
                                    FontSize="11"
                                    Foreground="{StaticResource SecondaryTextBrush}"/>


                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Text="Ratio"
                                    Margin="0,0,0,7"
                                    FontSize="11"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="Hold Shift"
                                    Margin="0,0,0,7"
                                    FontSize="11"
                                    Foreground="{StaticResource SecondaryTextBrush}"/>


                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Text="Centre"
                                    FontSize="11"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Text="Hold Ctrl"
                                    FontSize="11"
                                    Foreground="{StaticResource SecondaryTextBrush}"/>

                            </Grid>


                        </StackPanel>

                    </ScrollViewer>

                </Grid>

            </Border>

        </Grid>


        <!-- ========================================================= -->
        <!-- Status / action bar -->
        <!-- ========================================================= -->

        <Border
            Grid.Row="2"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0">

            <Grid Margin="12,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <TextBlock
                    Text="Ready"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{StaticResource SecondaryTextBrush}"/>

            </Grid>

        </Border>

    </Grid>

</Window>