<Window x:Class="FolderCustomizer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:FolderCustomizer.Views.Controls"
        mc:Ignorable="d"
        Title="Folder Customizer"
        Width="980"
        Height="650"
        MinWidth="820"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13">



    <!-- ============================================================= -->
    <!-- Root -->
    <!-- ============================================================= -->

    <Grid Background="{StaticResource WindowBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- Office-style command bar -->
        <!-- ========================================================= -->

        <Border
            Grid.Row="0"
            Background="{StaticResource ToolbarBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">

            <Grid Margin="8,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- Browse -->

                <Button
                    Grid.Column="0"
                    Name="btn_LoadFolder"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding SelectFolderCommand}">

                    <StackPanel
                        HorizontalAlignment="Center">

                        <TextBlock
                            Text="▣"
                            HorizontalAlignment="Center"
                            FontSize="20"
                            Foreground="{StaticResource AccentBrush}"/>

                        <TextBlock
                            Text="Browse folder"
                            Margin="0,4,0,0"
                            FontSize="11"/>

                    </StackPanel>

                </Button>


                <!-- Divider -->

                <Border
                    Grid.Column="1"
                    Width="1"
                    Margin="6,10"
                    Background="{StaticResource BorderBrush}"/>


                <!-- Add -->

                <Button
                    Grid.Column="2"
                    Name="btn_addImage"
                    IsEnabled="{Binding IsEditorEnabled}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding AddImageCommand}">

                    <StackPanel
                        HorizontalAlignment="Center">

                        <TextBlock
                            Text="+"
                            HorizontalAlignment="Center"
                            FontSize="23"
                            Foreground="{StaticResource AccentBrush}"/>

                        <TextBlock
                            Text="Add image"
                            Margin="0,3,0,0"
                            FontSize="11"/>

                    </StackPanel>

                </Button>


                <Border
                    Grid.Column="3"
                    Width="1"
                    Margin="6,10"
                    Background="{StaticResource BorderBrush}"/>


                <!-- Apply -->

                <Button
                    Grid.Column="4"
                    Style="{StaticResource ToolbarButtonStyle}"
                    x:Name="btn_ApplyToolbar"
                    IsEnabled="{Binding IsEditorEnabled}"
                    Command="{Binding ApplyIconCommand}">

                    <StackPanel
                        HorizontalAlignment="Center">

                        <TextBlock
                            Text="✓"
                            HorizontalAlignment="Center"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AccentBrush}"/>

                        <TextBlock
                            Text="Apply icon"
                            Margin="0,4,0,0"
                            FontSize="11"/>

                    </StackPanel>

                </Button>

                <Border
                    Grid.Column="5"
                    Width="1"
                    Margin="6,10"
                    Background="{StaticResource BorderBrush}"/>

                <Button
                    Grid.Column="6"
                    x:Name="btn_ClearStyle"
                    IsEnabled="{Binding HasExistingStyle}"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding ClearStyleCommand}">

                    <StackPanel HorizontalAlignment="Center">

                        <TextBlock
                            Text="×"
                            HorizontalAlignment="Center"
                            FontSize="22"
                            Foreground="{StaticResource AccentBrush}"/>

                        <TextBlock
                            Text="Clear style"
                            Margin="0,3,0,0"
                            FontSize="11"
                            LineHeight="14"
                            LineStackingStrategy="BlockLineHeight"/>

                    </StackPanel>

                </Button>
            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- Main content -->
        <!-- ========================================================= -->

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"
                                  MinWidth="470"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <controls:FolderEditorView Grid.Column="0"/>
            <controls:FolderPropertiesView Grid.Column="1"/>
        </Grid>


        <!-- ========================================================= -->
        <!-- Status / action bar -->
        <!-- ========================================================= -->

        <Border
            Grid.Row="2"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0">

            <Grid Margin="12,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <TextBlock
                    Text="Ready"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{StaticResource SecondaryTextBrush}"/>

            </Grid>

        </Border>

    </Grid>

</Window>